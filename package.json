{
    "name": "obsidian-workspace-assistant",
    "version": "2.1.1",
    "description": "An all-in-one assistant plugin integrating CSS snippets, folder management, lazy loading, status bar customization, and automatic numbering.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "node esbuild.config.mjs production",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "keywords": [
        "obsidian",
        "plugin",
        "assistant",
        "snippets",
        "numbering"
    ],
    "author": "Randy Allen <https://github.com/RandyAllenEEE>",
    "license": "GPL-3.0-only",
    "devDependencies": {
        "@types/node": "^24.19.2",
        "@types/react": "^18.0.0",
        "@types/react-dom": "^18.0.0",
        "builtin-modules": "^3.3.0",
        "esbuild": "^0.28.2",
        "jsdom": "^22.1.0",
        "obsidian": "^1.5.0",
        "tslib": "2.4.0",
        "typescript": "4.7.4",
        "vitest": "^5.1.1"
    },
    "overrides": {
        "obsidian": {
            "moment": "2.31.0"
        }
    }
}
